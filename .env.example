# UI 自动还原 Agent 运行时配置

# LLM（仅旧流程 ReconstructAgent 使用；新流程 PreciseAgent 请配置下方 VISION_* / TEXT_*）
LLM_BASE_URL=https://api.openai-proxy.org/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# OCR
OCR_ENGINE=tesseract
OCR_LANG=chi_sim+eng
TESSERACT_CMD=D:\Program Files\TesseractOCR\tesseract.exe

# 原型工具
PROTOTYPE_TOOL=svg
FIGMA_BRIDGE_URL=ws://localhost:8765

# 输出
OUTPUT_DIR=./output
DEBUG=false
SAVE_INTERMEDIATE=true

# ========================
# OmniParser 本地服务配置（可选）
# ========================
# 是否启用 OmniParser 作为特征提取后端
OMNIPARSER_ENABLED=true
# 服务地址（不要带 /parse/ 路径，客户端会自动拼接）
OMNIPARSER_URL=http://127.0.0.1:8000
# 请求超时（秒）
OMNIPARSER_TIMEOUT=120
# 检测框置信度阈值（当前服务端启动时固定，保留给未来扩展）
OMNIPARSER_BOX_THRESHOLD=0.05
# IoU 去重阈值（当前服务端启动时固定，保留给未来扩展）
OMNIPARSER_IOU_THRESHOLD=0.7
# 是否使用 PaddleOCR（当前服务端启动时固定，保留给未来扩展）
OMNIPARSER_USE_PADDLEOCR=false
# OmniParser 失败时是否回退到 OpenCV 提取
OMNIPARSER_FALLBACK=true
# 红框检测是否启用
RED_BOX_ENABLED=true

# 新流程（精准复刻 Agent）：acctoken OpenAI 兼容网关
VISION_BASE_URL=https://www.acctoken.com/v1
VISION_API_KEY=
VISION_MODEL=qwen3-vl-plus
VISION_NATIVE_GROUNDING=false
VISION_MAX_TOKENS=16000
VISION_TIMEOUT=120
TEXT_BASE_URL=https://www.acctoken.com/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek-v4-flash
TEXT_MAX_TOKENS=16000
TEXT_TIMEOUT=120

# SoM -> DesignSpec 分批生成（长页面防截断）
# 每批只让模型输出本批 id，按 id 机械合并；缺失 id 定向补发，覆盖不足则报错
SOM_BATCH_ENABLED=true
SOM_BATCH_SIZE=80
SOM_BATCH_MAX_ROUNDS=3
SOM_BATCH_MIN_COVERAGE=0.9
# 像素级颜色校正（预留接口，暂未实现，先留开关）
SOM_COLOR_BACKFILL=false
# DOM 路线默认走 Interpreter（VLM 语义生成）；true（或 CLI --fast）退回 computed style 几何直出，无语义推断
DOM_DIRECT_DESIGN=false
ROUTE=auto
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_HEADLESS=true
# URL 抓取时复用的登录态 JSON（可选，用 --login-state 导出）
PLAYWRIGHT_STORAGE_STATE=
DEVICE_SCALE_FACTOR=1
ENRICH_VISUAL=false
WAIT_NETWORKIDLE_TIMEOUT=30000
