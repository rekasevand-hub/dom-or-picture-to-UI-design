# UI 自动还原 Agent 运行时配置

# LLM（仅旧流程 ReconstructAgent 使用；新流程 PreciseAgent 请配置下方 VISION_* / TEXT_*）
LLM_BASE_URL=https://api.openai-proxy.org/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# OCR
OCR_ENGINE=tesseract
OCR_LANG=chi_sim+eng
TESSERACT_CMD=D:\Program Files\TesseractOCR\tesseract.exe

# 原型工具
PROTOTYPE_TOOL=svg
# 交付合同档位：legacy 保持旧路径；contract-v2 需显式提供捕获证据和验收输入。
DELIVERY_PROFILE=legacy

# Figma bridge settings live in ./figma_bridge.config.json.
# FIGMA_BRIDGE_* environment overrides are ignored unless that file sets
# "allow_env_overrides": true.

# 输出
OUTPUT_DIR=./output
DEBUG=false
SAVE_INTERMEDIATE=true

# ========================
# OmniParser 本地服务配置（可选）
# ========================
# 是否启用 OmniParser 作为特征提取后端
OMNIPARSER_ENABLED=true
# 服务地址（不要带 /parse/ 路径，客户端会自动拼接）
OMNIPARSER_URL=http://127.0.0.1:8000
# 请求超时（秒）
OMNIPARSER_TIMEOUT=120
# 检测框置信度阈值（当前服务端启动时固定，保留给未来扩展）
OMNIPARSER_BOX_THRESHOLD=0.05
# IoU 去重阈值（当前服务端启动时固定，保留给未来扩展）
OMNIPARSER_IOU_THRESHOLD=0.7
# 是否使用 PaddleOCR（当前服务端启动时固定，保留给未来扩展）
OMNIPARSER_USE_PADDLEOCR=false
# OmniParser 失败时是否回退到 OpenCV 提取
OMNIPARSER_FALLBACK=true
# 红框检测是否启用
RED_BOX_ENABLED=true

# 新流程（精准复刻 Agent）：acctoken OpenAI 兼容网关
VISION_BASE_URL=https://www.acctoken.com/v1
VISION_API_KEY=
VISION_MODEL=qwen3-vl-plus
VISION_NATIVE_GROUNDING=false
VISION_MAX_TOKENS=16000
VISION_TIMEOUT=120
# Grounding 图片运输分块。只限制单次 provider 请求，不缩放、不裁剪掉原图内容。
# 每块保持原图像素；相邻块重叠用于跨边界上下文，最终结果仍使用原图坐标。
VISION_TILE_MAX_HEIGHT=4096
VISION_TILE_OVERLAP=256
TEXT_BASE_URL=https://www.acctoken.com/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek-v4-flash
TEXT_MAX_TOKENS=16000
TEXT_TIMEOUT=120
# Reference-guided image edits. The endpoint must support multipart image[]
# (and preferably a native mask). Text-only generation is never used as a
# fallback when a source reference is required.
IMAGE_GENERATION_BASE_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=seedream-5.0-flash
IMAGE_GENERATION_TIMEOUT=120

# SoM -> DesignSpec 分批生成（长页面防截断）
# 每批只让模型输出本批 id，按 id 机械合并；缺失 id 定向补发，覆盖不足则报错
SOM_BATCH_ENABLED=true
SOM_BATCH_SIZE=80
SOM_BATCH_MAX_ROUNDS=3
SOM_BATCH_MIN_COVERAGE=0.9
# 像素级颜色校正（预留接口，暂未实现，先留开关）
SOM_COLOR_BACKFILL=false
ROUTE=auto
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_HEADLESS=true
# URL 抓取时复用的登录态 JSON（可选，用 --login-state 导出）
PLAYWRIGHT_STORAGE_STATE=
# 真实浏览器会话降级：无头被重定向/反爬拦截时，优先复用该持久化用户目录；
# 留空则依次尝试 storage_state 与全新有头 Chromium。
PLAYWRIGHT_USER_DATA_DIR=
# 是否允许用全新有头 Chromium 做最后一层真实会话重试（默认 true）
PLAYWRIGHT_HEADED_FALLBACK=true
DEVICE_SCALE_FACTOR=1
WAIT_NETWORKIDLE_TIMEOUT=30000

# SVG 文本兜底字体栈（DesignSpec 带 fontFamily 时优先用节点自身的；留空用内置默认栈）
# 例：SVG_FONT_STACK=-apple-system, "Segoe UI", "Microsoft YaHei", sans-serif
SVG_FONT_STACK=
# 文本基线的像素级微调（±1px 对齐到原截图墨迹；会多渲染一遍，置 0 关闭）
TEXT_ALIGN=true

# ========================
# 经验阈值（渲染 / 采集口径）：单一定义点在 src/app/tuning.py
# 默认值与"当初写死在代码里"的数值一致；下面是可覆盖项，需要时取消注释。
# 改这些不会报错，只会让像素变好或变差——改完请跑 output/_live_metrics.py 对比。
# ========================
# 文本基线 = y + h/2 + 该值 × fontSize
# TUNING_BASELINE_CENTER_EM=0.375
# 近白填充判定：min(RGB) 不低于该值，且通道极差不超过 SPREAD
# TUNING_WHITE_BG_MIN_RGB=242
# TUNING_WHITE_BG_MAX_SPREAD=10
# 深色/彩色衬底判定：亮度低于 LUMA，或饱和度高于 SAT
# TUNING_DARK_LUMA=0.40
# TUNING_CHROME_SAT=0.25
# 衬底上的文字取黑还是白（亮度分界）
# TUNING_BW_LUMA=0.5
# computed 颜色低于该 alpha 视为"没画"（透明底/极淡装饰层）
# TUNING_MIN_PAINT_ALPHA=0.02
# 单节点最多保留几层投影
# TUNING_MAX_SHADOWS=4
# 文本 ±1px 微调的接受门槛：至少比现状好 GAIN，且优于现状 RATIO 倍
# TUNING_TEXT_ALIGN_MIN_GAIN=0.2
# TUNING_TEXT_ALIGN_MIN_RATIO=0.5
# 截图里平均亮度高于该值的文本框视为空白，跳过对齐
# TUNING_TEXT_ALIGN_BLANK_MEAN=250.0
# 采集时序：哈希深链最多重抓几遍 / DOM 稳定判定
# TUNING_CAPTURE_ATTEMPTS=3
# TUNING_SETTLE_STABLE_MS=1500
# TUNING_SETTLE_CAP_MS=25000
# TUNING_NAV_IDLE_CAP_MS=15000
